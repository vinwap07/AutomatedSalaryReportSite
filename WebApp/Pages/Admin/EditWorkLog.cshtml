@page "{id:guid}"
@using Domain.ValueObjects
@using WebApp.Pages.Shared
@model WebApp.Pages.Admin.EditWorkLogModel
@{
    ViewData["Title"] = "Редактирование записи";
    var entry = Model.Entry;
    // Начальное состояние формы; при смене работника или единицы его пересчитывает js/work-entry.js
    var isLaborer = Model.IsLaborer;
    var isSalary = entry.IsSalary(isLaborer);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Редактирование записи</h1>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Index">← К журналу</a>
</div>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="m-0 ps-3">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <form method="post" class="work-entry @(isLaborer ? "is-laborer" : null) @(isSalary ? "is-salary" : null)">
            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <label class="form-label">Дата</label>
                    <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label">Работник</label>
                    <select name="Entry.EmployeeId" class="form-select employee-select" required>
                        <option value="">— работник —</option>
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id" data-specialty="@employee.Specialty" selected="@(employee.Id == entry.EmployeeId)">@employee.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 specialist-only">
                    <label class="form-label">Техника</label>
                    <select name="Entry.EquipmentId" class="form-select" disabled="@isLaborer">
                        <option value="">— без техники —</option>
                        @foreach (var equipment in Model.EquipmentList)
                        {
                            <option value="@equipment.Id" selected="@(equipment.Id == entry.EquipmentId)">@equipment.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Вид работы</label>
                    <select name="Entry.WorkTypeId" class="form-select work-type-select">
                        <option value="">— не выбрано —</option>
                        <partial name="_WorkTypeOptions" model="new WorkTypeOptionsModel(Model.WorkTypeGroups, entry.WorkTypeId)" />
                    </select>
                </div>
                <div class="col-4 specialist-only">
                    <label class="form-label">Часы</label>
                    <input type="number" name="Entry.WorkHours" value="@entry.WorkHours" min="0" max="24" class="form-control" disabled="@isLaborer" />
                </div>
                <div class="col-4 laborer-only">
                    <label class="form-label">Ед. изм.</label>
                    <select name="Entry.LaborerUnit" class="form-select laborer-unit-select" disabled="@(!isLaborer)">
                        @foreach (var unit in SpecialtyExtensions.LaborerUnits)
                        {
                            <option value="@unit" selected="@(unit == (entry.LaborerUnit ?? UnitOfMeasure.Hour))">@unit.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-4 hide-for-salary">
                    <label class="form-label">Расценка, ₽</label>
                    <input type="text" inputmode="decimal" name="Entry.Rate"
                           value="@entry.Rate?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                           class="form-control" disabled="@isSalary" />
                </div>
                <div class="col-4 hide-for-salary">
                    <label class="form-label">
                        <span class="specialist-only">Объём</span><span class="laborer-only">Количество</span>
                    </label>
                    <input type="text" inputmode="decimal" name="Entry.Volume"
                           value="@entry.Volume?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                           class="form-control" disabled="@isSalary" />
                </div>
                <div class="col-8 col-sm-4 salary-only">
                    <label class="form-label">Сумма оклада, ₽</label>
                    <input type="text" inputmode="decimal" name="Entry.Amount"
                           value="@entry.Amount?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                           class="form-control" disabled="@(!isSalary)" />
                </div>
                <div class="col-12 col-sm-6 specialist-only">
                    <label class="form-label">Единица измерения</label>
                    <select name="Entry.Unit" class="form-select" disabled="@isLaborer">
                        @foreach (var unit in SpecialtyExtensions.SpecialistUnits)
                        {
                            <option value="@unit" selected="@(unit == (entry.Unit ?? UnitOfMeasure.Ton))">@unit.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label">Причина отсутствия</label>
                    <select name="Entry.ReasonForAbsenceId" class="form-select">
                        <option value="">— не выбрано —</option>
                        @foreach (var reason in Model.Reasons)
                        {
                            <option value="@reason.Id" selected="@(reason.Id == entry.ReasonForAbsenceId)">@reason.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success px-4">Сохранить</button>
            </div>
        </form>
        <form method="post" asp-page-handler="Delete" data-confirm="Удалить эту запись?" class="mt-2">
            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить запись</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/work-entry.js" asp-append-version="true"></script>
}
