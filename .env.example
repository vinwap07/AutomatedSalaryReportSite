# Скопируйте в .env и заполните своими значениями

# PostgreSQL
POSTGRES_DB=my_employee_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Администратор, создаваемый при первом запуске (если в базе нет пользователей)
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change_me

# Часовой пояс приложения (для меток времени в аудит-логах)
TZ=Europe/Moscow
